{
  "$defs": {
    "ExtensionAbiMajor": {
      "description": "ABI major declared by an extension package.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "ExtensionCancellationContext": {
      "description": "Cancellation state and host deadline exposed to a hook invocation. The\nvalue carries no cancellation handle or runtime object.",
      "properties": {
        "cancelled": {
          "default": false,
          "type": "boolean"
        },
        "deadlineUnixMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ExtensionEventContext": {
      "description": "Fields shared by every lifecycle event.",
      "properties": {
        "cancellation": {
          "$ref": "#/$defs/ExtensionCancellationContext",
          "default": {
            "cancelled": false
          }
        },
        "cwd": {
          "type": "string"
        },
        "extensionId": {
          "type": "string"
        },
        "hasInteractiveClient": {
          "default": false,
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtensionModelRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "$ref": "#/$defs/ExtensionScopeIds",
          "default": {}
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sessionId": {
          "type": "string"
        }
      },
      "required": [
        "extensionId",
        "sessionId",
        "cwd",
        "sequence"
      ],
      "type": "object"
    },
    "ExtensionLifecycleEvent": {
      "description": "Stable public lifecycle names. Internal runtime events are translated into\nthese values rather than serialized directly.",
      "enum": [
        "extension_load",
        "session_start",
        "input",
        "before_session_switch",
        "session_switched",
        "before_session_fork",
        "session_forked",
        "before_model_selection",
        "model_selected",
        "before_run",
        "run_started",
        "turn_started",
        "context",
        "before_model_request",
        "before_provider_request_headers",
        "before_provider_request_raw",
        "provider_response",
        "provider_request_failed",
        "message_start",
        "message_update",
        "message_end",
        "tool_call",
        "tool_execution_start",
        "tool_execution_update",
        "tool_execution_end",
        "tool_result",
        "turn_completed",
        "run_ended",
        "run_error",
        "run_settled",
        "before_compaction",
        "compaction_succeeded",
        "compaction_failed",
        "session_shutdown",
        "extension_unload"
      ],
      "type": "string"
    },
    "ExtensionModelRef": {
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "type": "object"
    },
    "ExtensionScopeIds": {
      "description": "Correlation identifiers present only when the event belongs to that scope.",
      "properties": {
        "messageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolCallId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Engine-neutral event delivered to one extension instance.",
  "properties": {
    "abiMajor": {
      "$ref": "#/$defs/ExtensionAbiMajor"
    },
    "context": {
      "$ref": "#/$defs/ExtensionEventContext"
    },
    "event": {
      "$ref": "#/$defs/ExtensionLifecycleEvent"
    },
    "payload": true
  },
  "required": [
    "abiMajor",
    "event",
    "context",
    "payload"
  ],
  "title": "ExtensionEventEnvelope",
  "type": "object"
}
