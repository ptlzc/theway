#!/usr/bin/env bash
# =============================================================================
# pre-commit — synchronize generated SDK files, documentation, and CodeGraph.
#
# Proto changes stage the matching generated SDK files. Paired-document changes
# must contain synchronized English and Chinese content with current records.
#
# Enable once per clone with `make hooks`.
# =============================================================================
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ -n "$(git status --porcelain -- crates/theway-transport/proto/ sdk/proto)" ]; then
  echo "[pre-commit] crates/theway-transport/proto/ changed — syncing sdk (mirror + regenerate)"
  bash scripts/sdk-sync.sh

  # Include regenerated and newly created SDK files in the current commit.
  git add sdk/proto sdk/src/generated
  echo "[pre-commit] staged sdk/proto + sdk/src/generated"
fi

if git cat-file -e :scripts/verify-doc-i18n.py 2>/dev/null; then
  echo "[pre-commit] checking staged bilingual documentation pairs"
  scripts/verify-doc-i18n.py --cached
fi

if [ -d .codegraph ]; then
  if ! command -v codegraph >/dev/null 2>&1; then
    echo "[pre-commit] .codegraph exists but the codegraph command is unavailable" >&2
    exit 1
  fi
  echo "[pre-commit] synchronizing CodeGraph index"
  codegraph sync --quiet
fi
