{
  "name": "@theway-ai/sdk",
  "version": "1.0.1",
  "description": "TypeScript SDK for the theway gRPC daemon (theway.grpc.v1 + grpc.health.v1). Typed client for all RPCs, generated from proto/theway_grpc.proto via ts-proto.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proto/*": "./proto/*"
  },
  "files": [
    "dist",
    "proto",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gen": "bash scripts/generate.sh",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run gen && npm run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4"
  },
  "devDependencies": {
    "grpc-tools": "^1.13.0",
    "ts-proto": "^2.7.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/repository/npm-private/"
  }
}
