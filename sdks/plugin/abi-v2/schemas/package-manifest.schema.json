{
  "$defs": {
    "ExtensionAbiMajor": {
      "description": "ABI major declared by an extension package.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "ExtensionPermission": {
      "oneOf": [
        {
          "enum": [
            "session.write",
            "tools.register",
            "tools.override",
            "commands.register",
            "providers.register",
            "client.contribute",
            "workspace.read",
            "workspace.write",
            "process.spawn",
            "network.connect",
            "provider.raw"
          ]
        },
        {
          "pattern": "^secrets\\.read:[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
          "type": "string"
        }
      ]
    },
    "ExtensionScope": {
      "description": "Lifetime boundary for extension instances and their owned effects.",
      "enum": [
        "process",
        "session",
        "run",
        "request"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict on-disk package manifest for an ABI v2 runtime extension.",
  "properties": {
    "abi": {
      "$ref": "#/$defs/ExtensionAbiMajor"
    },
    "entry": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "optionalPermissions": {
      "items": {
        "$ref": "#/$defs/ExtensionPermission"
      },
      "type": "array"
    },
    "permissions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExtensionPermission"
      },
      "type": "array"
    },
    "priority": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/ExtensionScope"
    },
    "stateSchema": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "abi",
    "entry",
    "scope"
  ],
  "title": "ExtensionPackageManifest",
  "type": "object"
}
