{
  "name": "@theway-ai/sdk",
  "version": "0.1.11",
  "description": "Typed TypeScript SDK for theway, a terminal-first local AI agent runtime: commands, sessions, DAG orchestration, events, settings, and health over gRPC.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptlzc/theway.git",
    "directory": "sdks/client"
  },
  "homepage": "https://github.com/ptlzc/theway",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proto/*": "./proto/*"
  },
  "files": [
    "dist",
    "proto",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gen": "bash scripts/generate.sh",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run gen && npm run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4"
  },
  "devDependencies": {
    "grpc-tools": "^1.13.0",
    "ts-proto": "^2.7.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
